# ─────────────────────────────────────────────────────────────────
# MediWise Operations — Root Environment Variables (Vite frontend)
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file to git.
# ─────────────────────────────────────────────────────────────────

# Gemini AI API key (injected at runtime by AI Studio / Cloud Run).
# Only used by the Express server — never sent to the browser.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application base URL (Cloud Run service URL or local dev origin)
APP_URL="http://localhost:3000"

# ─── Server (see also server/.env.example) ────────────────────────
# These are read by server/server.js, not by Vite directly.
# Duplicated here for monorepo convenience when running from root.

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/mediwise
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/mediwise
MONGODB_URI="mongodb://127.0.0.1:27017/mediwise"

# Express server port (Vite proxies /api and /ws to this port)
PORT=5000
