# ─────────────────────────────────────────────────────────────────
# MediWise Backend — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit a real .env file to git.
# ─────────────────────────────────────────────────────────────────

# Express server port (frontend Vite proxy targets this)
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/mediwise
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/mediwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mediwise

# Gemini AI API key — used by POST /api/rx/scan
# Leave blank or set to YOUR_GEMINI_API_KEY to run in demo/mock mode
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# CORS allowed origin — set to your frontend URL
APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
