# ─────────────────────────────────────────────────────────────────
# MediWise Frontend — Environment Variables
# Copy this file to frontend/.env
# ─────────────────────────────────────────────────────────────────

# Port of the backend server — Vite uses this when proxying /api and /ws
VITE_BACKEND_PORT=5000

# Optional: override the API base URL for production deployments
# When set, the frontend sends fetch requests to this base instead of /api
# Leave blank for local dev (Vite proxy handles routing automatically)
VITE_API_BASE_URL=
