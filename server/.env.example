# ─────────────────────────────────────────
# MediWise Server — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit a real .env file to git
# ─────────────────────────────────────────

# Server port (Express / WebSocket)
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/mediwise
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/mediwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mediwise

# Gemini AI API key (server-side only — never expose to client)
# Obtain from: https://aistudio.google.com/app/apikey
# Leave blank or omit to activate clinical mock/demo mode
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Application base URL (used for OAuth callbacks / self-referential links)
APP_URL=http://localhost:3000

# Node environment
NODE_ENV=development
